#!/bin/bash
# ojota — control del sistema
#
#   ojota casa | afuera          cambiar de perfil
#   ojota status                 estado general
#   ojota start | stop | restart arrancar / parar / reiniciar el daemon
#   ojota logs [N]               últimas N líneas del log (default 40)
#   ojota test-notify            mandar una notificación de prueba
#   ojota prune                  borrar de Drive los clips más viejos que RETENTION_DAYS
#   ojota backup-config          subir config/ a Drive (config-backup/)
#   ojota install | uninstall    instalar / quitar el servicio (LaunchDaemon, pide sudo)

set -u

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
HERE="$(cd "$(dirname "$SELF")/.." && pwd)"
CONF="${OJOTA_CONF:-$HERE/config/ojota.conf}"
# shellcheck disable=SC1090
[ -f "$CONF" ] && . "$CONF"

PROFILE_FILE="$HERE/config/profile"
LOG="$HERE/logs/ojota.log"
HOOK_LOG="$HERE/logs/ojota-hook.log"
PY="$HERE/.venv/bin/python3"
DAEMON="$HERE/bin/ojota-daemon.py"
LABEL="com.nanotaboada.ojota"
PLIST_SYSTEM="/Library/LaunchDaemons/${LABEL}.plist"
PLIST_TEMPLATE="$HERE/deploy/${LABEL}.plist"
: "${DEFAULT_PROFILE:=afuera}"
: "${RCLONE_REMOTE:=gdrive}"
: "${RCLONE_PATH:=ojota}"
: "${RETENTION_DAYS:=30}"
: "${CONFIG_BACKUP:=1}"
DEST="${RCLONE_REMOTE}:${RCLONE_PATH}"

installed()   { [ -f "$PLIST_SYSTEM" ]; }
is_root()     { [ "$(id -u)" = 0 ]; }
daemon_pid()  { pgrep -f "$DAEMON" | head -1; }
need_root()   { is_root || exec sudo "$SELF" "$@"; }

# ── perfil ─────────────────────────────────────────────────────────────
set_profile() {
    echo "$1" >"$PROFILE_FILE"
    if [ "$1" = casa ]; then
        echo "🏠 perfil → casa   ·   🔕 notificaciones de movimiento en silencio"
    else
        echo "👁  perfil → afuera   ·   🔔 notificaciones activas"
    fi
    echo "   (el daemon lo toma en ~2s)"
}

# ── estado ─────────────────────────────────────────────────────────────
cmd_status() {
    local pid cur segs pend
    pid="$(daemon_pid)"
    cur="$(cat "$PROFILE_FILE" 2>/dev/null || echo "$DEFAULT_PROFILE")"
    echo "👁  ojota"
    [ "$cur" = casa ] && echo "   perfil:   🏠 casa (silencio)" \
                      || echo "   perfil:   👁  afuera"
    if [ -n "$pid" ]; then
        echo "   daemon:   ✅ corriendo (pid $pid)"
    else
        echo "   daemon:   🔴 detenido"
    fi
    if installed; then
        echo "   servicio: 📌 instalado (LaunchDaemon, arranca al bootear)"
    else
        echo "   servicio: ⚙️  no instalado (corrida manual — ver 'ojota install')"
    fi
    segs="$(ls "$HERE/clips/buffer/"*.ts 2>/dev/null | wc -l | tr -d ' ')"
    pend="$(ls "$HERE/clips/pending/"*.mp4 2>/dev/null | wc -l | tr -d ' ')"
    [ "${pend:-0}" -gt 0 ] && pend="⚠️  ${pend}"
    echo "   buffer:   ${segs} segmentos  ·  pendientes de subir: ${pend}"

    echo
    echo "últimos eventos:"
    local ev
    ev="$(grep -hE "MOVIMIENTO|clip armado|ALERTA|cámara recuperada" "$LOG" 2>/dev/null | tail -5)"
    [ -n "$ev" ] && echo "$ev" | sed 's/^/  /' || echo "  (sin eventos)"

    echo
    # errores desde que arrancó el daemon actual (no arrastrar los viejos)
    local since er
    since="$(grep -n "ojota daemon arriba" "$LOG" 2>/dev/null | tail -1 | cut -d: -f1)"
    er="$( { [ -n "$since" ] && tail -n "+$since" "$LOG"; grep -h . "$HOOK_LOG"; } 2>/dev/null \
          | grep -E " ERROR | FALLÓ|falló" | tail -5)"
    if [ -n "$er" ]; then
        echo "⚠️  errores (corrida actual):"; echo "$er" | sed 's/^/  /'
    else
        echo "errores: ✅ ninguno en la corrida actual"
    fi

    echo
    if command -v rclone >/dev/null; then
        local n
        n="$(rclone lsf "$DEST/" --include '*.mp4' 2>/dev/null | wc -l | tr -d ' ')"
        echo "☁️  Drive:    ${n} clips en $DEST/  (retención ${RETENTION_DAYS}d)"
        rclone about "${RCLONE_REMOTE}:" 2>/dev/null \
            | grep -E "^(Used|Free):" | sed 's/^/          /'
    fi
    local mnt
    mnt="$(grep -hE "prune:|backup-config:|heartbeat" "$LOG" 2>/dev/null | tail -1)"
    [ -n "$mnt" ] && echo "   mant.:    ${mnt##* INFO }"
}

# ── start / stop / restart ────────────────────────────────────────────
cmd_start() {
    if installed; then
        need_root start
        launchctl kickstart -p "system/$LABEL" >/dev/null 2>&1 \
            || launchctl bootstrap system "$PLIST_SYSTEM" 2>/dev/null
        sleep 2; svc_report
    else
        [ -n "$(daemon_pid)" ] && { echo "ya está corriendo (pid $(daemon_pid))"; return; }
        [ -x "$PY" ] || { echo "falta el venv ($PY). Ver README, paso 2." >&2; exit 1; }
        nohup "$PY" "$DAEMON" >/dev/null 2>&1 &
        sleep 2
        [ -n "$(daemon_pid)" ] && echo "👁  daemon arrancado (pid $(daemon_pid))" \
            || { echo "🔴 no arrancó, mirá $LOG" >&2; exit 1; }
    fi
}

cmd_stop() {
    if installed; then
        need_root stop
        launchctl kill SIGTERM "system/$LABEL" 2>/dev/null
        for _ in $(seq 1 20); do sleep 0.5; [ -z "$(daemon_pid)" ] && break; done
        [ -z "$(daemon_pid)" ] && echo "🛑 detenido (el servicio sigue instalado)" \
            || echo "⚠️  no frenó — probá 'ojota restart'"
    else
        local pid; pid="$(daemon_pid)"
        [ -z "$pid" ] && { echo "no estaba corriendo"; return; }
        kill -TERM "$pid"
        for _ in $(seq 1 20); do sleep 0.5; [ -z "$(daemon_pid)" ] && break; done
        [ -z "$(daemon_pid)" ] && echo "🛑 detenido" || { kill -9 "$pid"; echo "🛑 forzado"; }
    fi
}

cmd_restart() {
    if installed; then
        need_root restart
        launchctl kickstart -kp "system/$LABEL" >/dev/null 2>&1
        sleep 2; svc_report
    else
        cmd_stop; cmd_start
    fi
}

svc_report() {
    if [ -n "$(daemon_pid)" ]; then
        echo "👁  servicio corriendo (pid $(daemon_pid))"
    else
        echo "🔴 el servicio no levantó — mirá $HERE/logs/launchd.err.log" >&2
    fi
}

# ── mantenimiento ────────────────────────────────────────────────────
cmd_prune() {
    command -v rclone >/dev/null || { echo "falta rclone" >&2; exit 1; }
    local before after
    before="$(rclone lsf "$DEST/" --include '*.mp4' 2>/dev/null | wc -l | tr -d ' ')"
    rclone delete "$DEST/" --min-age "${RETENTION_DAYS}d" --include '*.mp4' 2>&1 \
        | grep -vE '^\s*$' | sed 's/^/  /'
    rclone rmdirs "$DEST/" --leave-root 2>/dev/null
    after="$(rclone lsf "$DEST/" --include '*.mp4' 2>/dev/null | wc -l | tr -d ' ')"
    echo "🧹 retención (>${RETENTION_DAYS}d): $((before - after)) borrados, quedan ${after}"
}

cmd_backup_config() {
    [ "$CONFIG_BACKUP" = 1 ] || { echo "CONFIG_BACKUP=0, no hago nada"; return; }
    command -v rclone >/dev/null || { echo "falta rclone" >&2; exit 1; }
    local tmp done; tmp="$(mktemp -d)"; done=""
    [ -r "$HERE/config/ojota.conf" ] && { cp "$HERE/config/ojota.conf" "$tmp/"; done="$done ojota.conf"; }
    [ -r "$HERE/config/profile" ]    && { cp "$HERE/config/profile" "$tmp/"; done="$done profile"; }
    # rclone.conf: la copia del repo puede ser de root; si no, la personal
    if [ -r "$HERE/config/rclone.conf" ]; then
        cp "$HERE/config/rclone.conf" "$tmp/rclone.conf"; done="$done rclone.conf"
    elif [ -r "$HOME/.config/rclone/rclone.conf" ]; then
        cp "$HOME/.config/rclone/rclone.conf" "$tmp/rclone.conf"; done="$done rclone.conf"
    fi
    rclone copy "$tmp/" "$DEST/config-backup/" 2>&1 | grep -vE '^\s*$' | sed 's/^/  /'
    rm -rf "$tmp"
    echo "💾 respaldado en $DEST/config-backup/ →$done  (secretos — carpeta privada)"
}

# ── install / uninstall ──────────────────────────────────────────────
cmd_install() {
    need_root install
    [ -f "$PLIST_TEMPLATE" ] || { echo "falta $PLIST_TEMPLATE" >&2; exit 1; }
    local user home src_rclone
    user="${SUDO_USER:-$(id -un)}"
    home="$(dscl . -read "/Users/$user" NFSHomeDirectory 2>/dev/null | awk '{print $2}')"
    home="${home:-/Users/$user}"

    # copia dedicada de la config de rclone (el daemon corre como root y
    # refresca el token; así no le cambia el dueño a la tuya personal)
    src_rclone="$home/.config/rclone/rclone.conf"
    if [ -f "$src_rclone" ]; then
        cp "$src_rclone" "$HERE/config/rclone.conf"
        chown root:wheel "$HERE/config/rclone.conf"
        chmod 600 "$HERE/config/rclone.conf"
        echo "(copié la config de rclone a config/rclone.conf)"
    else
        echo "⚠️  no encontré $src_rclone — configurá rclone primero (README)" >&2
    fi

    sed -e "s|__OJOTA_DIR__|$HERE|g" \
        -e "s|__USER_HOME__|$home|g" \
        "$PLIST_TEMPLATE" >"$PLIST_SYSTEM"
    chown root:wheel "$PLIST_SYSTEM"
    chmod 644 "$PLIST_SYSTEM"

    # matar cualquier corrida manual previa
    pkill -f "$DAEMON" 2>/dev/null && { echo "(frené el daemon manual)"; sleep 2; }

    launchctl bootout "system/$LABEL" 2>/dev/null
    if launchctl bootstrap system "$PLIST_SYSTEM"; then
        sleep 2
        echo "📌 instalado y arrancado (LaunchDaemon, como root)."
        svc_report
    else
        echo "⚠️  el plist se copió pero bootstrap falló. Revisá con:" >&2
        echo "    sudo launchctl bootstrap system $PLIST_SYSTEM" >&2
        exit 1
    fi
    echo
    echo "Para que la Mac no se duerma y el servicio siga 24/7:"
    echo "    sudo pmset -a sleep 0 disablesleep 1"
}

cmd_uninstall() {
    need_root uninstall
    installed || { echo "no estaba instalado"; return; }
    launchctl bootout "system/$LABEL" 2>/dev/null
    rm -f "$PLIST_SYSTEM" "$HERE/config/rclone.conf"
    echo "🗑  servicio quitado. El daemon ya no arranca al bootear."
    echo "   (para volver: 'ojota install'. Revertir pmset: sudo pmset -a disablesleep 0)"
}

# ── dispatch ─────────────────────────────────────────────────────────
case "${1:-}" in
    casa|afuera)   set_profile "$1" ;;
    status)        cmd_status ;;
    start)         cmd_start ;;
    stop)          cmd_stop ;;
    restart)       cmd_restart ;;
    install)       cmd_install ;;
    uninstall)     cmd_uninstall ;;
    logs)          tail -n "${2:-40}" "$LOG" ;;
    prune)         cmd_prune ;;
    backup-config) cmd_backup_config ;;
    test-notify)   "$HERE/bin/ojota-notify.sh" 3 "eyes" "👁 ojota — prueba" \
                       "Si ves esto, ntfy anda ($(date '+%H:%M'))" \
                       && echo "📨 enviada" ;;
    ""|-h|--help|help)
        sed -n '2,12p' "$SELF" | sed 's/^# \{0,1\}//' ;;
    *)
        echo "comando desconocido: $1" >&2
        sed -n '2,12p' "$SELF" | sed 's/^# \{0,1\}//' >&2
        exit 1 ;;
esac
