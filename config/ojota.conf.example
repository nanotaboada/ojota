# ojota — configuración
# Copiar a ojota.conf y completar. ojota.conf NO se versiona (tiene la
# contraseña RTSP y el topic de ntfy). Formato KEY=VALUE: lo leen tanto
# bash (source) como el daemon Python. Sin espacios alrededor del "=".

# ── Cámara ────────────────────────────────────────────────────────────
# Stream principal (grabación, se copia sin re-encodear). La ruta RTSP
# depende del fabricante; verificá con:
#   ffprobe -rtsp_transport tcp -i "rtsp://USER:PASS@CAMARA_IP:554/RUTA"
RTSP_URL="rtsp://USUARIO:CLAVE@CAMARA_IP:554/stream"
# Substream de baja resolución (solo detección). Dejar vacío para usar
# el principal también para detectar.
RTSP_SUBSTREAM_URL="rtsp://USUARIO:CLAVE@CAMARA_IP:554/substream"
RTSP_TRANSPORT="tcp"

# ── Detección de movimiento ───────────────────────────────────────────
DETECT_FPS=3                # frames/s a analizar (más = más CPU)
DETECT_WIDTH=320            # ancho al que se reduce antes de comparar
PIXEL_DELTA=18              # 0-255: cuánto cambia un píxel para "contar"
MOTION_AREA_PCT=1.5         # % de píxeles cambiados para disparar evento
MOTION_MIN_FRAMES=3         # frames seguidos sobre el umbral para disparar
LIGHT_CHANGE_PCT=70         # si cambia más que esto de golpe = cambio de
                           # luz (IR día/noche, luz que se prende): ignorar
DETECT_WARMUP_SECONDS=15    # ignorar movimiento los primeros N s tras
                           # (re)conectar: el H.264 tarda en estabilizar
DETECT_ROI="0,0,1,1"       # zona donde se busca movimiento (izq,arriba,der,
                           # abajo en fracciones 0-1). 0,0,1,1 = frame entero.
                           # NO recorta el video: el clip siempre es completo.

# ── Armado / desarmado ───────────────────────────────────────────────
# El daemon corre siempre. `ojota salir` (alias `armar`) arma: captura +
# detección + subida + notificaciones. `ojota volver` (alias `desarmar`)
# desarma: frena los dos ffmpeg, no graba nada; solo siguen los chequeos
# de salud (cámara caída, heartbeat).
DEFAULT_PROFILE=armado     # estado al bootear si no hay config/profile
                           # (fail-safe: ante duda, armado)

# ── Grabación del clip ────────────────────────────────────────────────
LIVE_UPLOAD=1              # mientras estás armado, subir el ring buffer a
                          # gdrive:.../live/ en continuo (retención ~3 min).
                          # Así, si te llevan la Mac en medio de un evento,
                          # el video ya está en Drive salvo los últimos ~10s.
SEGMENT_SECONDS=4           # tamaño de cada segmento del ring buffer
PRECAPTURE_SECONDS=8        # segundos antes del evento a incluir
POSTCAPTURE_SECONDS=10      # espera sin movimiento antes de cerrar el
                           # evento (fusiona ráfagas). El clip termina 2 s
                           # después del último movimiento, no +N.
BUFFER_RETENTION_SECONDS=60 # cuánto historial mantener en el ring buffer

# ── Notificaciones push (ntfy.sh) ─────────────────────────────────────
# El topic es de hecho un secreto: quien lo sepa puede leer tus avisos
# (con link al clip y un frame). Generá uno largo y guardalo solo acá:
#   echo "ojota-$(openssl rand -hex 20)"
NTFY_SERVER="https://ntfy.sh"
NTFY_TOPIC="ojota-CAMBIAR-POR-UNO-ALEATORIO"
NOTIFY_SILENCE_MINUTES=5    # tras avisar, no volver a avisar por N min.
                           # SOLO afecta las notificaciones: el video se
                           # graba y sube igual.
INSTANT_NOTIFY_DELAY_SECONDS=45  # el aviso instantáneo ("Movimiento en
                           # curso") se difiere N s: si en ese lapso la
                           # presencia te reconoce (volviste), se cancela.
                           # Cubre la latencia de reconexión del celu al
                           # WiFi al entrar. 0 = avisar en el acto.
CAMERA_DOWN_ALERT_MINUTES=5 # alerta (prioridad alta) si la cámara no
                           # responde por N min
EVENT_BURST_COUNT=10        # si hay ≥ N eventos en EVENT_BURST_MINUTES,
EVENT_BURST_MINUTES=15      # manda una alerta "muchos eventos" (algo raro)

# ── Auto-armado por presencia del celu en la WiFi ────────────────────
# El daemon pinguea al celu. Si no responde por PRESENCE_AWAY_MINUTES →
# armado; cuando vuelve a responder → desarmado (instantáneo). Reservá la
# IP del celu en el router. Vacío = desactivado.
PHONE_IP=""
PRESENCE_POLL_SECONDS=10
PRESENCE_AWAY_MINUTES=2    # sin ver el celu N min → armar
RETURN_GRACE_SECONDS=120   # al volver, los clips de estos últimos N s se
                          # archivan en probablemente-vos/ sin notificar
                          # (sos vos entrando). No se borran.

# Alternativa por geofence (ntfy): removida del daemon por simplicidad,
# ver commit f36a673 si el ping no alcanzara.

# ── Google Drive (rclone) ─────────────────────────────────────────────
RCLONE_REMOTE="gdrive"
RCLONE_PATH="ojota"
RETENTION_DAYS=30           # borrar de Drive clips más viejos que esto
RETENTION_CHECK_HOURS=24    # cada cuánto corre la limpieza
PENDING_RETRY_MINUTES=3     # cada cuánto reintentar subidas que fallaron
CONFIG_BACKUP=1             # subir config/ a Drive (config-backup/) para
                           # poder reproducir el setup. OJO: incluye la
                           # pass RTSP y el token — mantené la carpeta privada.

# ── Heartbeat externo (opcional) ──────────────────────────────────────
# Ping periódico a un servicio tipo healthchecks.io: si la Mac se apaga
# (corte de luz, crash), ese servicio te avisa. Vacío = desactivado.
HEARTBEAT_URL=""
HEARTBEAT_MINUTES=15

# ── Rutas ─────────────────────────────────────────────────────────────
# Normalmente no hace falta: los scripts detectan la raíz del repo solos.
# Descomentar solo para forzar otra ubicación.
#OJOTA_HOME="$HOME/ojota"
